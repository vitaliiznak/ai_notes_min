# Read by `npm run dev:server` and by docker compose.
DATABASE_URL=postgres://notes:notes@localhost:5432/notes
# openai (default) needs OPENAI_API_KEY. fake runs the whole app without a key,
# with clearly labelled placeholder output.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# AI_TIMEOUT_MS=30000
# If you raise the timeout, also raise Compose stop_grace_period above
# timeout × 2 + 15s (drainBudgetMs in server/src/config.ts).
