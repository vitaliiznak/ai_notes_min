# Read by `npm run dev:server` and by docker compose when you run the app locally.
DATABASE_URL=postgres://notes:notes@localhost:5432/notes
# Local runs use the real model by default. Paste your OpenAI API key on the
# OPENAI_API_KEY line below (https://platform.openai.com/api-keys). The server
# will not start until that line has a key.
# No key yet? Set AI_PROVIDER=fake instead. The app still runs; summaries and
# tags are placeholders that start with "[fake AI]".
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# AI_TIMEOUT_MS=30000
# If you raise the timeout, also raise Compose stop_grace_period above
# timeout × 2 + 15s (drainBudgetMs in server/src/config.ts).
